<Application x:Class="Produtos.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>

        <!-- Paleta -->
        <SolidColorBrush x:Key="CorLateral" Color="#1E293B" />
        <SolidColorBrush x:Key="CorLateralHover" Color="#334155" />
        <SolidColorBrush x:Key="CorDestaque" Color="#2563EB" />
        <SolidColorBrush x:Key="CorDestaqueHover" Color="#1D4ED8" />
        <SolidColorBrush x:Key="CorFundo" Color="#F1F5F9" />
        <SolidColorBrush x:Key="CorCartao" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CorBorda" Color="#CBD5E1" />
        <SolidColorBrush x:Key="CorTexto" Color="#0F172A" />
        <SolidColorBrush x:Key="CorTextoSuave" Color="#64748B" />
        <SolidColorBrush x:Key="CorPerigo" Color="#DC2626" />
        <SolidColorBrush x:Key="CorPerigoHover" Color="#B91C1C" />
        <SolidColorBrush x:Key="CorSucesso" Color="#15803D" />
        <SolidColorBrush x:Key="CorAviso" Color="#B45309" />

        <!-- Item do menu lateral -->
        <Style x:Key="ItemMenu" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="Menu" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Fundo" Background="Transparent" CornerRadius="6" Padding="14,10" Margin="0,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{StaticResource CorLateralHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{StaticResource CorDestaque}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botões -->
        <Style x:Key="BotaoBase" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource CorDestaque}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fundo" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CorDestaqueHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotaoPerigo" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
            <Setter Property="Background" Value="{StaticResource CorPerigo}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CorPerigoHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Campos -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="TituloPainel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
        </Style>

        <Style x:Key="SubtituloPainel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
            <Setter Property="Margin" Value="0,4,0,18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CorCartao}" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>

    </Application.Resources>
</Application>

<Window x:Class="Produtos.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:modelos="clr-namespace:Produtos.Core.Models;assembly=Produtos.Core"
        xmlns:views="clr-namespace:Produtos.Wpf.Views"
        Title="Cadastro de Produtos" Height="640" Width="1040" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CorFundo}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Cartão de detalhes usado em "Buscar" e "Excluir" -->
        <DataTemplate DataType="{x:Type modelos:Produto}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Margin" Value="0,5" />
                        <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Text="ID" Foreground="{StaticResource CorTextoSuave}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Id}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="Nome" Foreground="{StaticResource CorTextoSuave}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="Preço" Foreground="{StaticResource CorTextoSuave}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Preco, StringFormat=C}" />
                <TextBlock Grid.Row="3" Text="Estoque" Foreground="{StaticResource CorTextoSuave}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Estoque, StringFormat={}{0} un.}" />
                <TextBlock Grid.Row="4" Text="Categoria" Foreground="{StaticResource CorTextoSuave}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Categoria}" />
                <TextBlock Grid.Row="5" Text="Situação" Foreground="{StaticResource CorTextoSuave}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Situacao}" />
                <TextBlock Grid.Row="6" Text="Cadastrado em" Foreground="{StaticResource CorTextoSuave}" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DataCadastro, StringFormat=dd/MM/yyyy HH:mm}" />
                <TextBlock Grid.Row="7" Text="Excluído em" Foreground="{StaticResource CorTextoSuave}" />
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DataExclusao, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue=—}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== MENU ============================== -->
        <Border Grid.RowSpan="2" Background="{StaticResource CorLateral}" Padding="14,22">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,0,22">
                    <TextBlock Text="Cadastro de Produtos" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="ADO.NET · SQLite" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="navInserir" Style="{StaticResource ItemMenu}" Checked="Menu_Checked" AutomationProperties.AutomationId="navInserir">1  ·  Inserir produto</RadioButton>
                    <RadioButton x:Name="navListar" Style="{StaticResource ItemMenu}" Checked="Menu_Checked" AutomationProperties.AutomationId="navListar">2  ·  Listar produtos</RadioButton>
                    <RadioButton x:Name="navBuscar" Style="{StaticResource ItemMenu}" Checked="Menu_Checked" AutomationProperties.AutomationId="navBuscar">3  ·  Buscar por ID</RadioButton>
                    <RadioButton x:Name="navAtualizar" Style="{StaticResource ItemMenu}" Checked="Menu_Checked" AutomationProperties.AutomationId="navAtualizar">4  ·  Atualizar produto</RadioButton>
                    <RadioButton x:Name="navExcluir" Style="{StaticResource ItemMenu}" Checked="Menu_Checked" AutomationProperties.AutomationId="navExcluir">5  ·  Excluir produto</RadioButton>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="0  ·  Sair" Click="BtnSair_Click"
                        HorizontalContentAlignment="Left" AutomationProperties.AutomationId="btnSair">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BotaoBase}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#FCA5A5" />
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Padding" Value="14,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CorLateralHover}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>
        </Border>

        <!-- ============================== PAINÉIS ============================== -->
        <Grid Grid.Column="1" Margin="32,28,32,16">

            <!-- 1. Inserir -->
            <StackPanel x:Name="pnlInserir" Visibility="Collapsed">
                <TextBlock Text="Inserir produto" Style="{StaticResource TituloPainel}" />
                <TextBlock Text="Preencha os dados e clique em Salvar. O Id é gerado pelo banco." Style="{StaticResource SubtituloPainel}" />
                <Border Style="{StaticResource Cartao}">
                    <StackPanel>
                        <views:ProdutoFormulario x:Name="formInserir" />
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Content="Salvar" Style="{StaticResource BotaoPrimario}" Click="BtnSalvarNovo_Click" IsDefault="True" AutomationProperties.AutomationId="btnSalvarNovo" />
                            <Button Content="Limpar" Style="{StaticResource BotaoSecundario}" Margin="10,0,0,0" Click="BtnLimparNovo_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 2. Listar -->
            <DockPanel x:Name="pnlListar" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Listar produtos" Style="{StaticResource TituloPainel}" />
                    <TextBlock Text="Dê dois cliques em um produto ativo para editá-lo." Style="{StaticResource SubtituloPainel}" />
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Left" Content="Recarregar" Style="{StaticResource BotaoSecundario}" Click="BtnRecarregar_Click" AutomationProperties.AutomationId="btnRecarregar" />
                        <CheckBox x:Name="chkMostrarExcluidos" DockPanel.Dock="Left" Content="Mostrar excluídos" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13"
                                  Checked="ChkMostrarExcluidos_Changed" Unchecked="ChkMostrarExcluidos_Changed" AutomationProperties.AutomationId="chkMostrarExcluidos" />
                        <Button x:Name="btnRestaurar" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Restaurar selecionado"
                                Style="{StaticResource BotaoSecundario}" Click="BtnRestaurar_Click" IsEnabled="False" />
                    </DockPanel>
                </StackPanel>

                <TextBlock x:Name="txtResumoLista" DockPanel.Dock="Bottom" Margin="2,10,0,0" Foreground="{StaticResource CorTextoSuave}" FontSize="13" />

                <DataGrid x:Name="gridProdutos" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#E2E8F0" Background="White"
                          RowHeight="32" FontSize="13" AlternatingRowBackground="#F8FAFC"
                          SelectionChanged="GridProdutos_SelectionChanged" MouseDoubleClick="GridProdutos_MouseDoubleClick"
                          AutomationProperties.AutomationId="gridProdutos">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9" />
                            <Setter Property="Foreground" Value="{StaticResource CorTextoSuave}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ativo}" Value="False">
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="2*" />
                        <DataGridTextColumn Header="Preço" Binding="{Binding Preco, StringFormat=C}" Width="110" />
                        <DataGridTextColumn Header="Estoque" Binding="{Binding Estoque}" Width="80" />
                        <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="*" />
                        <DataGridTextColumn Header="Situação" Binding="{Binding Situacao}" Width="90" />
                        <DataGridTextColumn Header="Cadastro" Binding="{Binding DataCadastro, StringFormat=dd/MM/yyyy HH:mm}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- 3. Buscar por ID -->
            <StackPanel x:Name="pnlBuscar" Visibility="Collapsed">
                <TextBlock Text="Buscar produto por ID" Style="{StaticResource TituloPainel}" />
                <TextBlock Text="A busca também encontra produtos excluídos (soft delete) e mostra a situação de cada um." Style="{StaticResource SubtituloPainel}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBox x:Name="txtIdBuscar" Width="140" KeyDown="TxtIdBuscar_KeyDown" AutomationProperties.AutomationId="txtIdBuscar" />
                    <Button Content="Buscar" Style="{StaticResource BotaoPrimario}" Margin="10,0,0,0" Click="BtnBuscar_Click" AutomationProperties.AutomationId="btnBuscar" />
                </StackPanel>
                <Border x:Name="cartaoBusca" Style="{StaticResource Cartao}" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Left">
                    <ContentControl x:Name="conteudoBusca" />
                </Border>
            </StackPanel>

            <!-- 4. Atualizar -->
            <StackPanel x:Name="pnlAtualizar" Visibility="Collapsed">
                <TextBlock Text="Atualizar produto" Style="{StaticResource TituloPainel}" />
                <TextBlock Text="Informe o ID, carregue o produto, altere os campos e salve." Style="{StaticResource SubtituloPainel}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBox x:Name="txtIdAtualizar" Width="140" KeyDown="TxtIdAtualizar_KeyDown" AutomationProperties.AutomationId="txtIdAtualizar" />
                    <Button Content="Carregar" Style="{StaticResource BotaoSecundario}" Margin="10,0,0,0" Click="BtnCarregarAtualizar_Click" AutomationProperties.AutomationId="btnCarregarAtualizar" />
                </StackPanel>
                <Border Style="{StaticResource Cartao}">
                    <StackPanel>
                        <TextBlock x:Name="txtEditando" Text="Nenhum produto carregado." Foreground="{StaticResource CorTextoSuave}" Margin="0,0,0,14" />
                        <views:ProdutoFormulario x:Name="formAtualizar" IsEnabled="False" />
                        <Button x:Name="btnSalvarAtualizacao" Content="Salvar alterações" Style="{StaticResource BotaoPrimario}"
                                HorizontalAlignment="Left" Margin="0,22,0,0" IsEnabled="False" Click="BtnSalvarAtualizacao_Click"
                                AutomationProperties.AutomationId="btnSalvarAtualizacao" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 5. Excluir -->
            <StackPanel x:Name="pnlExcluir" Visibility="Collapsed">
                <TextBlock Text="Excluir produto" Style="{StaticResource TituloPainel}" />
                <TextBlock Text="Por padrão a exclusão é lógica (soft delete): o produto some da lista mas pode ser restaurado. Marque a opção abaixo para apagar a linha do banco." Style="{StaticResource SubtituloPainel}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBox x:Name="txtIdExcluir" Width="140" KeyDown="TxtIdExcluir_KeyDown" AutomationProperties.AutomationId="txtIdExcluir" />
                    <Button Content="Carregar" Style="{StaticResource BotaoSecundario}" Margin="10,0,0,0" Click="BtnCarregarExcluir_Click" AutomationProperties.AutomationId="btnCarregarExcluir" />
                </StackPanel>
                <Border x:Name="cartaoExcluir" Style="{StaticResource Cartao}" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Left">
                    <StackPanel>
                        <ContentControl x:Name="conteudoExcluir" />
                        <CheckBox x:Name="chkExcluirPermanente" Content="Excluir permanentemente (DELETE físico, não pode ser desfeito)"
                                  Margin="0,16,0,0" FontSize="13" Foreground="{StaticResource CorPerigo}" />
                        <Button Content="Excluir" Style="{StaticResource BotaoPerigo}" HorizontalAlignment="Left" Margin="0,16,0,0"
                                Click="BtnExcluir_Click" AutomationProperties.AutomationId="btnExcluir" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ============================== STATUS ============================== -->
        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="32,8">
            <DockPanel>
                <TextBlock x:Name="txtInfoBanco" DockPanel.Dock="Right" Foreground="{StaticResource CorTextoSuave}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                <TextBlock x:Name="txtStatus" Text="Pronto." FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="txtStatus" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
